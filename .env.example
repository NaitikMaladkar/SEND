# ========================================
# SUPABASE (Database + Auth)
# Create a free project at https://supabase.com
# ========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ========================================
# RESEND (Sending Emails)
# Create a free account at https://resend.com
# ========================================
RESEND_API_KEY=re_xxxxxxxx

# ========================================
# MAILGUN (Receiving Emails via Webhook)
# Create a free account at https://mailgun.com
# ========================================
MAILGUN_WEBHOOK_SIGNING_KEY=your-mailgun-signing-key

# ========================================
# APP CONFIG
# ========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAIL_DOMAIN=send.dedyn.io

# ========================================
# VERCEL (auto-set by Vercel, do not set manually)
# ========================================
# VERCEL_URL
